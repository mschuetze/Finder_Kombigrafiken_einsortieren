				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>AppleScript ausführen</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}	-- Ausgewählten Ordner aus Finder / Kurzbefehl ermitteln	set targetFolder to item 1 of input		tell application "Finder"		-- Alle Unterordner finden, die ein "+" im Namen enthalten		set comboFolders to (every folder of targetFolder whose name contains "+")				repeat with comboFolder in comboFolders			set comboName to name of comboFolder			set allFiles to every file of comboFolder						-- Namen der Speaker anhand des "+" trennen			set AppleScript's text item delimiters to "+"			set speakerList to text items of comboName			set AppleScript's text item delimiters to ""						-- Für jeden Speaker verarbeiten			repeat with speakerName in speakerList				-- Whitespaces trimmen				set cleanSpeaker to do shell script "echo " &amp; quoted form of speakerName &amp; " | xargs"								-- Zielordner anlegen, falls nicht vorhanden				if not (exists folder cleanSpeaker of targetFolder) then					make new folder at targetFolder with properties {name:cleanSpeaker}				end if				set destFolder to folder cleanSpeaker of targetFolder								-- Dateien kopieren und umbenennen				repeat with currentFile in allFiles					set origName to name of currentFile										-- Kombi-Namen durch Speaker-Namen im Dateinamen ersetzen					set AppleScript's text item delimiters to comboName					set nameParts to text items of origName					set AppleScript's text item delimiters to cleanSpeaker					set newName to nameParts as string					set AppleScript's text item delimiters to ""										-- Prüfen, ob eine gleichnamige Datei im Zielordner bereits existiert und löschen					if exists file newName of destFolder then						delete file newName of destFolder					end if										-- Datei duplizieren &amp; umbenennen					set copiedFile to duplicate currentFile to destFolder with replacing					set name of copiedFile to newName				end repeat			end repeat						-- Kombi-Ordner nach der Verarbeitung rot markieren (2 = Rot)			set label index of comboFolder to 2					end repeat	end tell		set currentVersion to "v0.2.0"	display notification "Grafiken einsortiert und Kombi-Ordner rot markiert." with title "Figma Export (" &amp; currentVersion &amp; ")"	return inputend run</string>
				</dict>
